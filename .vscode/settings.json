{
  // ───────────────────────── Typography ─────────────────────────
  "editor.fontFamily": "'JetBrains Mono', 'SF Mono', Menlo, monospace",
  "editor.fontSize": 15,
  "editor.fontWeight": "400",
  "editor.lineHeight": 1.7,
  "editor.letterSpacing": 0.2,
  // calt = ligatures (=> -> :: ...), zero = slashed zero
  "editor.fontLigatures": "'calt', 'zero'",

  // ───────────────────────── Editor feel ────────────────────────
  "editor.cursorBlinking": "phase",
  "editor.cursorSmoothCaretAnimation": "on",
  "editor.smoothScrolling": true,
  "editor.minimap.enabled": false,
  "editor.stickyScroll.enabled": true,
  "editor.renderLineHighlight": "all",
  "editor.scrollBeyondLastLine": false,
  "editor.rulers": [100],
  "editor.bracketPairColorization.enabled": true,
  "editor.guides.bracketPairs": "active",
  "editor.inlayHints.enabled": "onUnlessPressed",
  "editor.inlayHints.fontSize": 12,
  "editor.formatOnSave": true,

  // ───────────────────────── Workbench ──────────────────────────
  "workbench.colorTheme": "Catppuccin Macchiato",
  "workbench.iconTheme": "catppuccin-macchiato",
  "workbench.list.smoothScrolling": true,
  "workbench.tree.indent": 16,
  "workbench.tree.renderIndentGuides": "always",
  "workbench.editor.labelFormat": "short",
  "window.title": "g2way ⛩  ${separator}${activeEditorShort}",

  // Subtle project identity: teal accents so g2way windows are
  // recognizable at a glance among other workspaces.
  "workbench.colorCustomizations": {
    "[Catppuccin Macchiato]": {
      "titleBar.activeBackground": "#1e2030",
      "titleBar.activeForeground": "#8bd5ca",
      "activityBarBadge.background": "#8bd5ca",
      "activityBarBadge.foreground": "#181926",
      "statusBar.background": "#1e2030",
      "statusBarItem.remoteBackground": "#8bd5ca",
      "statusBarItem.remoteForeground": "#181926",
      "focusBorder": "#8bd5ca"
    }
  },

  // ───────────────────────── Terminal ───────────────────────────
  "terminal.integrated.fontFamily": "'JetBrains Mono', 'SF Mono', Menlo, monospace",
  "terminal.integrated.fontSize": 13,
  "terminal.integrated.lineHeight": 1.4,
  "terminal.integrated.cursorBlinking": true,
  "terminal.integrated.cursorStyle": "line",
  "terminal.integrated.smoothScrolling": true,

  // ───────────────────────── Rust ───────────────────────────────
  "[rust]": {
    "editor.defaultFormatter": "rust-lang.rust-analyzer"
  },
  // Same gate the project uses pre-commit (clippy -D warnings via make check)
  "rust-analyzer.check.command": "clippy",
  "rust-analyzer.check.extraArgs": ["--", "-D", "warnings"],
  // Keep rust-analyzer's builds out of cargo's way (separate target dir)
  "rust-analyzer.cargo.targetDir": true,
  "rust-analyzer.inlayHints.parameterHints.enable": false,
  "rust-analyzer.inlayHints.closureReturnTypeHints.enable": "with_block",
  "rust-analyzer.lens.references.method.enable": false,

  "[toml]": {
    "editor.defaultFormatter": "tamasfe.even-better-toml"
  },

  // ───────────────────────── Error Lens ─────────────────────────
  "errorLens.fontSize": "12px",
  "errorLens.fontStyleItalic": true,
  "errorLens.messageBackgroundMode": "message",
  "errorLens.enabledDiagnosticLevels": ["error", "warning"],

  // ───────────────────────── Files & search ─────────────────────
  "files.watcherExclude": {
    "**/target/**": true
  },
  "search.exclude": {
    "**/target": true,
    "**/Cargo.lock": true
  },
  "explorer.fileNesting.enabled": true,
  "explorer.fileNesting.patterns": {
    "Cargo.toml": "Cargo.lock, rustfmt.toml, clippy.toml, deny.toml"
  },
  "files.associations": {
    "deploy/k8s/*.yaml": "yaml"
  },
  "files.insertFinalNewline": true,
  "files.trimTrailingWhitespace": true
}
